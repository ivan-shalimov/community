@baseUrl = http://localhost:3000/api/members
@authBaseUrl = http://localhost:3000/api/auth
@username = admin@community.local
@password = Password1!

### Login
# @name login
POST {{authBaseUrl}}/login
Content-Type: application/json

{
    "username": "{{username}}",
	"password": "{{password}}"
}

### Create Member Invite
POST {{baseUrl}}/invite
Content-Type: application/json

{
  "name": "John Doe",
  "email": "john.doe@example.com"
}

### Verify Member Invite
GET {{baseUrl}}/invite/verify/some-unique-token?email=john.doe@example.com
Accept: application/json

### Register Member
POST {{baseUrl}}/register
Content-Type: application/json

{
  "token": "v1HqiLr1ZUEQcSH_q901M5OMh_jPVhrXnlMh2btVbsXUOSZsODBBsqQCToZfFmt0CKETn37fUsis30-LjN2Tkg",
  "name": "admin",
  "email": "admin@community.local",
  "password": "Password1!"
}

### Get All Members
GET {{baseUrl}}
Accept: application/json
Authorization: Bearer {{login.response.body.accessToken}}

### Get Member by ID
GET {{baseUrl}}/123e4567-e89b-12d3-a456-426614174000
Accept: application/json
Authorization: Bearer {{login.response.body.accessToken}}

### Update Member Name
PUT {{baseUrl}}/123e4567-e89b-12d3-a456-426614174000/name
Content-Type: application/json
Authorization: Bearer {{login.response.body.accessToken}}

{
  "name": "John Smith"
}

### Delete Member
DELETE {{baseUrl}}/123e4567-e89b-12d3-a456-426614174000
Accept: application/json